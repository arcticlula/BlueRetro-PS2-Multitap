[mapping:main]
archive: libmain.a
entries:
    main (noflash)
    atomic (noflash)
    core0_stall (noflash)
    core0_stall_highint_hdl (noflash)
    gpio (noflash)
    intr (noflash)
    led (noflash)
    delay (noflash)
    wired_bare (noflash)
    ps_spi (noflash)

[sections:gcov_info]
entries:
    .gcov_info

[scheme:gcov_default]
entries:
    gcov_info -> flash_rodata

[mapping:gcov_info]
archive: *
entries:
    * (gcov_default);
    gcov_info -> flash_rodata KEEP() SURROUND(_gcov_info)
